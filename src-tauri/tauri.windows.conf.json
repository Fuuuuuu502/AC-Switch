{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-node.ps1 && pnpm build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "AC-Switch",
      "width": 960,
      "height": 780,
      "minWidth": 780,
      "minHeight": 560,
      "decorations": true,
      "hiddenTitle": false
    }]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
